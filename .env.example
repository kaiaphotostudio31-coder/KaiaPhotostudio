PORT=3000
NODE_ENV=development
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=ganti-dengan-service-role-key
ADMIN_JWT_SECRET=ganti-dengan-random-secret-panjang
ADMIN_EMAIL=admin@kaiaphotostudio.com
ADMIN_PASSWORD=ganti-dengan-password-kuat

# Google OAuth (server-side only)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://YOUR-SITE.netlify.app/api/admin/google/oauth/callback
# Optional: env refresh token. Otherwise OAuth callback stores an encrypted token in Supabase settings.
GOOGLE_REFRESH_TOKEN=
GOOGLE_TOKEN_ENCRYPTION_KEY=ganti-dengan-random-secret-panjang
GOOGLE_CALENDAR_ID=
PUBLIC_SITE_URL=https://YOUR-SITE.netlify.app
